model OnlinePayment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  citizenUserId  String @map("citizen_user_id") @db.Uuid
  contribuabilId String @map("contribuabil_id") @db.Uuid

  // Payment details
  suma       Decimal @db.Decimal(12, 2)
  status     String  @default("initiated") @db.VarChar(20) // initiated, pending, confirmed, failed, cancelled
  modalitate String  @default("ghiseul_ro") @db.VarChar(30)

  // Gateway
  gatewayRef      String? @map("gateway_ref") @db.VarChar(255)
  gatewayResponse Json?   @map("gateway_response") @db.JsonB

  // Selected debts to pay
  selectedDebts Json @default("[]") @map("selected_debts") @db.JsonB // array of {impozitId, amount}

  // Linked payment (after confirmation)
  plataId String? @map("plata_id") @db.Uuid

  stripeEventId String? @unique @map("stripe_event_id") @db.VarChar(255)

  initiatedAt DateTime  @default(now()) @map("initiated_at") @db.Timestamptz
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizenUser CitizenUser @relation(fields: [citizenUserId], references: [id])

  @@index([tenantId, citizenUserId, status])
  @@index([gatewayRef])
  @@map("online_payments")
}

model StripeWebhookEvent {
  tenantId      String   @map("tenant_id") @db.Uuid
  stripeEventId String   @id @map("stripe_event_id") @db.VarChar(255)
  gatewayRef    String?  @map("gateway_ref") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("stripe_webhook_events")
}

// =============================================================================
// 14. PHASE 4: CONTACT MESSAGES
// =============================================================================

model ContactMessage {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  citizenUserId String? @map("citizen_user_id") @db.Uuid
  name          String  @db.VarChar(255)
  email         String  @db.VarChar(255)
  phone         String? @db.VarChar(50)
  subject       String  @db.VarChar(255)
  message       String

  status    String    @default("new") @db.VarChar(20) // new, read, replied, closed
  repliedAt DateTime? @map("replied_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizenUser CitizenUser? @relation(fields: [citizenUserId], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("contact_messages")
}

// Atomic sequence for chitanță numbers (avoids race conditions)
model ChitantaSequence {
  tenantId   String @map("tenant_id") @db.Uuid
  year       Int
  currentVal Int    @default(1) @map("current_val")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
  @@map("chitanta_sequences")
}

// Atomic sequence for document numbers (avoids race conditions)
model DocumentSequence {
  tenantId   String @map("tenant_id") @db.Uuid
  prefix     String @db.VarChar(10)
  year       Int
  currentVal Int    @default(0) @map("current_val")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, prefix, year])
  @@map("document_sequences")
}

// =============================================================================
// 15. BUDGET CLASSIFICATION CODES
// =============================================================================

model BudgetCode {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique @db.VarChar(20)
  nameRo     String  @map("name_ro") @db.VarChar(255)
  category   String  @db.VarChar(20) // venituri | cheltuieli
  parentCode String? @map("parent_code") @db.VarChar(20)
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([category, isActive])
  @@map("budget_codes")
}
