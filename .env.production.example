# =============================================================================
# PrimărIA — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before deployment:
#   cp .env.production.example .env
#
# IMPORTANT: Never commit the .env file to version control.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Pooled connection via PgBouncer (used by the application at runtime)
DATABASE_URL=postgresql://primaria_admin:CHANGE_ME@pgbouncer:6432/primaria

# Direct connection to PostgreSQL (used by Prisma for migrations)
DIRECT_DATABASE_URL=postgresql://primaria_admin:CHANGE_ME@postgres:5432/primaria

# Shadow DB connection (required for strict migration drift checks)
# Recommended: separate database used only for Prisma diff operations
SHADOW_DATABASE_URL=postgresql://primaria_admin:CHANGE_ME@postgres:5432/primaria_shadow

# PostgreSQL container credentials
POSTGRES_USER=primaria_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=primaria

# ── Auth (NextAuth.js) ───────────────────────────────────────────────────────
# The canonical URL of your deployment
NEXTAUTH_URL=https://your-domain.ro

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_SECRET=same-as-above

# ── JWT (Citizen Portal) ────────────────────────────────────────────────────
# Separate secret for citizen-facing JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# ── Payments ─────────────────────────────────────────────────────────────────
# In production use Stripe only
PAYMENT_MODE=stripe
STRIPE_MUNICIPAL_PRICE_ID=price_your_monthly_municipality_plan
STRIPE_PRICE_COMUNA_ID=price_for_comuna_plan
STRIPE_PRICE_ORAS_ID=price_for_oras_plan
STRIPE_PRICE_MUNICIPIU_ID=price_for_municipiu_plan

# ── ROeID (Feature Flag) ─────────────────────────────────────────────────────
# Keep disabled until full government-certified integration is implemented.
ROEID_ENABLED=false
NEXT_PUBLIC_ROEID_ENABLED=false
ROEID_DISCOVERY_URL=https://roeid.ro/.well-known/openid-configuration
ROEID_CLIENT_ID=
ROEID_CLIENT_SECRET=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_BUCKET=primaria-documents

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.ro
SMTP_PORT=587
SMTP_USER=noreply@your-domain.ro
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=PrimărIA <noreply@your-domain.ro>

# ── App ──────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://your-domain.ro

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte hex key for encrypting sensitive data at rest
# Generate with: openssl rand -hex 32
CNP_ENCRYPTION_KEY=generate-32-byte-hex-key
# Salt used for deterministic CNP hash lookup by tenant
# Generate with: openssl rand -base64 32
CNP_TENANT_SALT_SECRET=generate-with-openssl-rand-base64-32

# ── Super Admin ──────────────────────────────────────────────────────────────
# Initial admin account created on first seed
SUPER_ADMIN_EMAIL=admin@your-domain.ro
SUPER_ADMIN_PASSWORD=CHANGE_ME

# Tenant ID (UUID) — identifies which municipality this deployment serves
# Required for portal auth routes (login, register, forgot-password, contact)
TENANT_ID=your-tenant-uuid-here
