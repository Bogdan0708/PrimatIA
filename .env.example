# ===================================
# PrimărIA — Environment Configuration
# ===================================

# Database (PostgreSQL via PgBouncer)
DATABASE_URL="postgresql://primaria_app:primaria_dev_password@localhost:6432/primaria?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://primaria_app:primaria_dev_password@localhost:5435/primaria"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="primaria_minio"
MINIO_SECRET_KEY="primaria_minio_secret"
MINIO_BUCKET="primaria-documents"
MINIO_USE_SSL=false

# CNP Encryption
CNP_ENCRYPTION_KEY="your-32-byte-hex-key-change-in-production"
CNP_TENANT_SALT_SECRET="your-salt-secret-change-in-production"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="ro"

# Super Admin (initial setup)
SUPER_ADMIN_EMAIL="admin@primaria.ro"
SUPER_ADMIN_PASSWORD="change-this-in-production"
