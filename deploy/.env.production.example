# Database (Cloud SQL via Unix socket)
DATABASE_URL=postgresql://postgres:PASSWORD@/primaria?host=/cloudsql/PROJECT:europe-central2:primaria-db

# Auth
NEXTAUTH_URL=https://primaria-HASH.run.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_MODE=stripe

# AI (optional - LM Studio won't be available in cloud)
# Use OpenAI or leave empty for keyword-only chatbot
OPENAI_API_KEY=sk-...
# LM_STUDIO_URL= (not available in cloud deployment)

