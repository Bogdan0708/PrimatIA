# =============================================================================
# PrimărIA — Production Environment Variables
# =============================================================================
# Variables marked [SECRET] should be stored in GCP Secret Manager.
# Variables marked [ENV] are set as Cloud Run env vars.
# =============================================================================

# --- Database ---
# [SECRET] PgBouncer connection (transaction mode) — used by the application
DATABASE_URL=postgresql://postgres:PASSWORD@/primaria?host=/cloudsql/PROJECT:europe-central2:primaria-db&pgbouncer=true
# [SECRET] Direct PostgreSQL connection — used for migrations (bypasses PgBouncer)
DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@/primaria?host=/cloudsql/PROJECT:europe-central2:primaria-db

# --- Auth ---
# [SECRET] NextAuth session signing key (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# [ENV] Must match the Cloud Run service URL
NEXTAUTH_URL=https://primaria-HASH.europe-central2.run.app
# [ENV] Required for NextAuth behind Cloud Run proxy
AUTH_TRUST_HOST=true
# [SECRET] JWT signing key for citizen portal tokens (generate: openssl rand -base64 32)
JWT_SECRET=generate-with-openssl-rand-base64-32

# --- CNP Encryption (citizen personal ID protection) ---
# [SECRET] AES-256 encryption key (generate: openssl rand -hex 32)
CNP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
# [SECRET] Per-tenant salt derivation secret (generate: openssl rand -base64 32)
CNP_TENANT_SALT_SECRET=generate-with-openssl-rand-base64-32

# --- Multi-tenancy ---
# [ENV] Default tenant ID for single-tenant deployments
TENANT_ID=your-tenant-uuid

# --- Redis (rate limiting, sessions) ---
# [SECRET] Memorystore Redis URL (get host: gcloud redis instances describe primaria-cache --region=europe-central2)
REDIS_URL=redis://10.x.x.x:6379

# --- Stripe Payments ---
# [SECRET] Stripe API key
STRIPE_SECRET_KEY=sk_live_...
# [SECRET] Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# [ENV] Payment mode
PAYMENT_MODE=stripe

# --- AI Gateway (chatbot) ---
# [SECRET] AI gateway endpoint URL
AI_GATEWAY_URL=https://your-ai-gateway.run.app
# [SECRET] AI gateway API key
AI_GATEWAY_KEY=your-api-key

# --- Storage (MinIO / future GCS migration) ---
# Currently using MinIO — plan to migrate to GCS for production
# MINIO_ENDPOINT=storage.example.com
# MINIO_PORT=443
# MINIO_ACCESS_KEY=access-key
# MINIO_SECRET_KEY=secret-key
# MINIO_BUCKET=primaria-documents
# MINIO_USE_SSL=true

# --- SMTP (email notifications — not yet wired in deploy.sh) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=password
# SMTP_FROM=noreply@example.com
